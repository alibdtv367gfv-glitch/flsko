{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "preview"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "production"
      }
    },
    "apk": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "preview"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
