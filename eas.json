{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "preview",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      },
      "credentialsSource": "local",
      "resourceClass": "medium"
    },
    "apk": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "preview",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      },
      "credentialsSource": "local",
      "resourceClass": "medium"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flsko-api.flsko.workers.dev",
        "EXPO_PUBLIC_APP_CHANNEL": "production",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {}
  }
}
