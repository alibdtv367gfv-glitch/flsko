# Example server env — copy to hosting secrets. Do not commit real values.

# API public base (mobile/web client)
EXPO_PUBLIC_API_BASE_URL=https://flsko-api.flsko.workers.dev

# Google OAuth (must match Google Cloud Console redirect URI)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://flsko-api.flsko.workers.dev/api/google/callback

# Session signing
JWT_SECRET=

# AI providers
FLSKO_GEMINI_API_KEY=
FLSKO_OPENAI_API_KEY=
HF_TOKEN=
FLSKO_POLLINATIONS_API_KEY=

# Google Cloud Storage (optional; Node/Cloud Run — not required on Workers)
GCP_BUCKET_NAME=
GCP_SERVICE_ACCOUNT_JSON=

# Remote GPU / open-source hosts (no local weights)
REMOTE_SKYREELS_URL=
REMOTE_SKYREELS_KEY=
REMOTE_ALLEGRO_URL=
REMOTE_ALLEGRO_KEY=
REMOTE_GENSTUDIO_URL=
REMOTE_GENSTUDIO_KEY=
REMOTE_COSMOS_URL=
REMOTE_COSMOS_KEY=
REMOTE_VTUBER_WS=
